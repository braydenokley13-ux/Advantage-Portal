# ─────────────────────────────────────────────────────────────────────────────
# Advantage Journal Portal — environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in values when you
# want to run against a real Supabase project. Without these set, the app
# runs in mock mode against the in-memory store and works fully offline.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle
# at build time. Treat anything else as server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Switch the data layer:
#   mock      → in-memory store + seed (offline, default)
#   supabase  → SupabaseAdapter against the configured project
#
# If supabase is selected but URL/anon key are missing or invalid, the
# provider logs a console warning and gracefully falls back to mock.
NEXT_PUBLIC_DATA_MODE=mock

# Supabase project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for invite flows, server actions, and anything
# that needs to bypass RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: full Postgres URL for running migrations / psql -f.
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Where the deployed app lives. Used in auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode gate.
#   "1" (default for now) → /login shows the demo user picker and the
#                          top-bar avatar lets you switch demo users.
#   "0"                  → demo affordances are hidden; the app expects a
#                          real Supabase Auth (or equivalent) sign-in to
#                          populate the session. Set this to "0" before
#                          any public launch so visitors can't pick an
#                          admin user from the login page.
NEXT_PUBLIC_DEMO_MODE=1
