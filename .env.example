# ─────────────────────────────────────────────────────────────────────────────
# Advantage Journal Portal — environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in values when you
# want to run against a real Supabase project. Without these set, the app
# runs in mock mode against the in-memory store and works fully offline.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle
# at build time. Treat anything else as server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Switch the data layer:
#   mock      → in-memory store + seed (offline, default)
#   supabase  → SupabaseAdapter against the configured project
#
# If supabase is selected but URL/anon key are missing or invalid, the
# provider logs a console warning, gracefully falls back to mock, and the
# /login page shows a banner explaining exactly what is misconfigured.
#
# IMPORTANT: every NEXT_PUBLIC_* value is compiled into the browser bundle
# at BUILD time. On Vercel, editing this in the dashboard does nothing
# until you trigger a fresh redeploy with "Use existing Build Cache" OFF.
# A restart or instant rollback will not pick up the new value.
NEXT_PUBLIC_DATA_MODE=mock

# Supabase project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for invite flows, server actions, and anything
# that needs to bypass RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: full Postgres URL for running migrations / psql -f.
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Where the deployed app lives. Used in auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Email SMTP — required when NEXT_PUBLIC_DATA_MODE=supabase
#
# The simple path is Gmail SMTP. You can also use any SMTP provider by
# setting SMTP_* instead of GMAIL_*.
#
# Gmail uses your personal Gmail account to send auth emails via SMTP.
# You must generate a Gmail App Password — your regular password will NOT work.
#
# How to get an App Password:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification if not already on
#   3. Search "App passwords" → create one for "Mail"
#   4. Copy the 16-character password (spaces don't matter) into GMAIL_APP_PASSWORD
# ─────────────────────────────────────────────────────────────────────────────

# Your full Gmail address, e.g. yourname@gmail.com
GMAIL_USER=

# The 16-character App Password generated above (NOT your Gmail login password)
GMAIL_APP_PASSWORD=

# Optional generic SMTP override. Leave blank when using Gmail above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional sender identity. Defaults to "Advantage Portal" and the SMTP user.
EMAIL_FROM_NAME=Advantage Portal
EMAIL_FROM_ADDRESS=

# Shared secret for the Supabase "Send Email" auth hook.
# In Supabase Dashboard → Authentication → Hooks → Send Email, click
# "Generate secret" and paste the full v1,whsec_... value here.
SUPABASE_AUTH_HOOK_SECRET=
